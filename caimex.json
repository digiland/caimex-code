{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "caimex",
    "opencode",
    "anthropic",
    "openai",
    "google",
    "github-copilot"
  ],
  "provider": {
    "caimex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Caimex Gateway",
      "options": {
        "baseURL": "https://caimex.econetai.co.zw:2052/v1"
      },
      "models": {
        "Caimex/moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": {
            "context": 262144,
            "input": 262144,
            "output": 32000
          },
          "cost": {
            "input": 12,
            "output": 15,
            "cache_read": 0,
            "cache_write": 0
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 160000
  },
  "model": "caimex/Caimex/moonshotai/kimi-k2.6"
}
